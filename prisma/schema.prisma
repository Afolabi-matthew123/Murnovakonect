generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  SUPER_ADMIN
  SCHOOL_ADMIN
  STAFF
  PARENT
  STUDENT
}

enum RoleName {
  SUPER_ADMIN
  SCHOOL_ADMIN
  STAFF
  PARENT
  STUDENT
}

enum DomainType {
  WEBSITE
  PORTAL
  MODULE
  CUSTOM
}

model School {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  domain         String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  motto          String?
  tagline        String?
  vision         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  branding            SchoolBranding?
  domains             SchoolDomain[]
  sitePages           SchoolSitePage[]
  users               User[]
  students            Student[]
  staff               Staff[]
  classRooms          ClassRoom[]
  academicSessions    AcademicSession[]
  terms               Term[]
  timetableSlots      TimetableSlot[]
  lessonPlans         LessonPlan[]
  behaviourIncidents  BehaviourIncident[]
  behaviourPoints     BehaviourPoint[]
  portalSubscriptions ParentPortalSubscription[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]
  results             Result[]
  attendanceRecords   AttendanceRecord[]
  analyticsSnapshots  AnalyticsSnapshot[]
  roles               Role[]
  schoolUsers         SchoolUser[]

  @@index([slug])
  @@index([createdAt])
}

model SchoolBranding {
  id             String   @id @default(uuid())
  schoolId       String   @unique
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  motto          String?
  tagline        String?
  headerImage    String?
  faviconUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SchoolDomain {
  id        String     @id @default(uuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  host      String     @unique
  type      DomainType
  module    String?
  isPrimary Boolean    @default(false)
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([schoolId])
  @@index([type])
  @@index([module])
}

model SchoolSitePage {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  contentJson Json
  isHome      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, slug])
  @@index([schoolId])
}

// USER MODEL
model User {
  id String @id @default(uuid())

  // MULTI-IDENTIFIER AUTHENTICATION FIELDS
  email     String? @unique
  phone     String? @unique
  studentId String? @unique // Links to Student.admissionNo
  staffId   String? @unique // Links to Staff.staffNo
  parentId  String? @unique // Optional parent identifier for parent users

  // USER TYPE AND BASIC INFO
  userType      UserType @default(STUDENT)
  displayName   String?
  password      String
  emailVerified Boolean  @default(false)

  // ACCOUNT STATUS
  isActive   Boolean   @default(true)
  mfaEnabled Boolean   @default(false)
  mfaSecret  String?
  lastLogin  DateTime?

  // TIMESTAMPS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TENANCY
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  // RELATIONS
  roles               UserRole[]
  children            Student[]                  @relation("ParentChildren")
  portalSubscriptions ParentPortalSubscription[]
  refreshTokens       RefreshToken[]

  // Profile relations
  studentProfile Student? @relation("UserStudent", fields: [studentId], references: [admissionNo])
  staffProfile   Staff?   @relation("UserStaff", fields: [staffId], references: [staffNo])

  // Parent-specific fields
  childrenProfiles Student[]       @relation("ParentGuardian")
  schoolUsers      SchoolUser[]
  studentParents   StudentParent[]

  @@index([email])
  @@index([phone])
  @@index([studentId])
  @@index([staffId])
  @@index([parentId])
  @@index([schoolId])
  @@index([userType])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  description String?
  schoolId    String?
  school      School?      @relation(fields: [schoolId], references: [id])
  permissions Permission[]
  userRoles   UserRole[]
  createdAt   DateTime     @default(now())

  @@index([schoolId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  roles       Role[]
  createdAt   DateTime @default(now())
}

model UserRole {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// STUDENT
model Student {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  admissionNo String    @unique
  gender      String?
  dob         DateTime?
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // LINK TO USER ACCOUNT
  userId String? @unique
  user   User?   @relation("UserStudent")

  // PARENT/GUARDIAN RELATIONSHIPS
  guardianId String?
  guardian   User?   @relation("ParentChildren", fields: [guardianId], references: [id])

  // ADDITIONAL PARENTS
  parentId String?
  parent   User?   @relation("ParentGuardian", fields: [parentId], references: [id])

  classRoomId String?
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])

  attendances         AttendanceRecord[]
  results             Result[]
  behaviourIncidents  BehaviourIncident[]        @relation("StudentIncidents")
  behaviourPoints     BehaviourPoint[]
  feeInvoices         FeeInvoice[]
  portalSubscriptions ParentPortalSubscription[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentParents StudentParent[]

  @@index([schoolId])
  @@index([userId])
  @@index([guardianId])
  @@index([parentId])
  @@index([classRoomId])
  @@index([admissionNo])
}

// STAFF
model Staff {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  staffNo   String  @unique
  email     String?
  phone     String?
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // LINK TO USER ACCOUNT
  userId String? @unique
  user   User?   @relation("UserStaff")

  roles          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  timetableSlots TimetableSlot[]

  @@index([schoolId])
  @@index([userId])
  @@index([staffNo])
  @@index([email])
}

model ClassRoom {
  id             String          @id @default(uuid())
  name           String
  arm            String?
  level          Int?
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students       Student[]
  timetableSlots TimetableSlot[]
  createdAt      DateTime        @default(now())

  @@index([schoolId])
}

model AcademicSession {
  id        String   @id @default(uuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     Term[]
  createdAt DateTime @default(now())

  @@index([schoolId])
}

model Term {
  id                  String                     @id @default(uuid())
  name                String
  startsAt            DateTime?
  endsAt              DateTime?
  sessionId           String
  session             AcademicSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schoolId            String
  school              School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results             Result[]
  portalSubscriptions ParentPortalSubscription[]

  @@index([schoolId])
  @@index([sessionId])
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  date       DateTime
  status     String
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([date])
}

model FeeInvoice {
  id        String    @id @default(uuid())
  invoiceNo String    @unique
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  dueDate   DateTime?
  status    String
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments  Payment[]
  createdAt DateTime  @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([invoiceNo])
}

model Payment {
  id        String      @id @default(uuid())
  amount    Float
  method    String
  paidAt    DateTime    @default(now())
  invoiceId String?
  invoice   FeeInvoice? @relation(fields: [invoiceId], references: [id])
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([invoiceId])
}

model Result {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   String
  score     Float
  termId    String?
  term      Term?    @relation(fields: [termId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([termId])
}

model TimetableSlot {
  id          String     @id @default(uuid())
  classRoomId String?
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  staffId     String?
  staff       Staff?     @relation(fields: [staffId], references: [id])
  subject     String
  day         Int
  startTime   String
  endTime     String
  schoolId    String
  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([schoolId])
  @@index([classRoomId])
  @@index([staffId])
}

model LessonPlan {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdBy   String?
  status      String
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
}

model BehaviourIncident {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation("StudentIncidents", fields: [studentId], references: [id], onDelete: Cascade)
  reportedBy String?
  type       String
  notes      String?
  points     Int      @default(0)
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

model BehaviourPoint {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  points    Int
  reason    String?
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

model ParentPortalSubscription {
  id                   String   @id @default(uuid())
  parentId             String
  parent               User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId            String?
  student              Student? @relation(fields: [studentId], references: [id])
  schoolId             String
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId               String?
  term                 Term?    @relation(fields: [termId], references: [id])
  amount               Float
  virtualAccountNumber String?
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([schoolId])
  @@index([parentId])
  @@index([studentId])
  @@index([termId])
}

model AnalyticsSnapshot {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scope     String
  scopeId   String?
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([scope, scopeId])
}

/// ===============================
/// PHASE 2 — IDENTITY & RELATIONSHIP MODELS
/// ===============================

model SchoolUser {
  id       String @id @default(uuid())
  userId   String
  schoolId String

  roles  String[] // ["PARENT", "STAFF", "ADMIN"]
  status String   @default("ACTIVE")

  user   User   @relation(fields: [userId], references: [id])
  school School @relation(fields: [schoolId], references: [id])

  @@unique([userId, schoolId])
}

model StudentParent {
  id        String @id @default(uuid())
  studentId String
  parentId  String // User ID

  relation String // father | mother | guardian
  verified Boolean @default(false)

  student Student @relation(fields: [studentId], references: [id])
  parent  User    @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

/// =======================================================
/// FM-1 BASE MODELS — ARCHITECTURAL FREEZE
/// -------------------------------------------------------
/// ❌ DO NOT MODIFY existing FM-1 models below this line
/// ✅ New models must be added AFTER this section
/// Frozen at tag: fm1-freeze
/// =======================================================

/// ===============================
/// FM-2.3 — Navigation Intelligence
/// Persistent Navigation Memory
/// ===============================
model NavigationPattern {
  id     String @id @default(uuid())
  userId String
  role   String

  entryNode String
  exitNode  String

  frequency  Int   @default(1)
  confidence Float @default(0.1)

  lastUsedAt DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([userId, role])
  @@index([entryNode, exitNode])
}
