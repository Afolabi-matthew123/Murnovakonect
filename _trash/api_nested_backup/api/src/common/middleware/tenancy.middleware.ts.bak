import { Injectable, NestMiddleware } from '@nestjs/common';
import { PrismaService } from '../../database/prisma.service'; // adjust relative path if your prisma.service is elsewhere
import { Request, Response, NextFunction } from 'express';
import { resolveSlugFromHost } from '../../common/utils/domain.utils'; // adjust path as needed

@Injectable()
export class TenancyMiddleware implements NestMiddleware {
  constructor(private prisma: PrismaService) {}

  async use(req: Request & { schoolSlug?: string }, res: Response, next: NextFunction) {
    try {
      const host = (req.hostname || (req.headers && req.headers.host)) as string | undefined;
      const schoolSlug = host ? resolveSlugFromHost(host) : undefined;

      if (schoolSlug) {
        // Set a Postgres session variable for RLS awareness. Prisma exposes $executeRawUnsafe
        await this.prisma.$executeRawUnsafe(
          `SELECT set_config('murnova.current_school_slug', $1, false)`,
          schoolSlug,
        );
      } else {
        // clear it
        await this.prisma.$executeRawUnsafe(
          `SELECT set_config('murnova.current_school_slug', '', false)`,
        );
      }

      req.schoolSlug = schoolSlug;
    } catch (err) {
      // don't break request chain on middleware errors; log in real app
      // console.error('Tenancy middleware error', err);
    } finally {
      next();
    }
  }
}
